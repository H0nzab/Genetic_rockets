<Window x:Class="Genetic_rockets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:Genetic_rockets.UI.Rendering"
        Title="Smart Rockets - Zápočtový program" Height="600" Width="800">

    <Grid Background="#1E1E1E">
        <render:SimulationRenderer x:Name="MainRenderer" />

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15">
            <TextBlock x:Name="GenerationText" Foreground="White" FontSize="18" FontWeight="Bold" />
            <TextBlock x:Name="TickText" Foreground="LightGray" FontSize="14" Margin="0,5,0,0" />

            <TextBlock x:Name="SuccessText" Foreground="LightGreen" FontSize="14" Margin="0,5,0,0" Text="V cíli: 0" />

            <Border BorderBrush="#555555" BorderThickness="1" Background="#252525" 
                    Height="60" Width="150" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Canvas x:Name="GraphCanvas" ClipToBounds="True" />
            </Border>
        </StackPanel>
    </Grid>
</Window>